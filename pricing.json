  "_meta": {
    "currency": "AUD",
    "gst_inclusive": true,
    "verified": "2026-07-10",
    "source": "AU independent shop retail (bench), Newcastle NSW",
    "method": "band lookup by panel; Apple OOW is a reference column, never an input",
    "battery_pricing_model": "Battery price tracks the RISK OF OPENING THE HANDSET, not the cost of the cell. Access is through the display, so a battery job inherits the display's fragility and replacement cost. This is why battery price does not fall with model age the way screen price does.",
    "genuine_original": {
      "stocked": false,
      "indicative_price": [
        800,
        850
      ],
      "lead_time": "2-5 days, special order",
      "decays": "price does not fall with model age",
      "note": "Bought almost exclusively by customers with unrecoverable data on a dead handset who will not accept a factory wipe at authorised service. Renders as an availability note, not a price column."
    },
